{
  "name": "retailsync",
  "version": "0.1.0",
  "private": true,
  "description": "RetailSync online store: Aiven PostgreSQL (stock integrity), Apache Kafka (event stream), and OpenSearch (typo-tolerant search).",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "start": "npm run start --workspace backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:conn": "npm run test:conn --workspace backend --",
    "db:migrate": "npm run db:migrate --workspace backend",
    "search:init": "npm run search:init --workspace backend --",
    "kafka:topics": "npm run kafka:topics --workspace backend --",
    "seed": "npm run seed --workspace backend"
  }
}
