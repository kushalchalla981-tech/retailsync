{
  "name": "retailsync",
  "version": "0.1.0",
  "private": true,
  "description": "RetailSync online store: Aiven PostgreSQL (stock integrity), Apache Kafka (event stream), and OpenSearch (typo-tolerant search).",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "start": "npm run start --workspace backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
