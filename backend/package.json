{
  "name": "@retailsync/backend",
  "version": "0.1.0",
  "private": true,
  "description": "RetailSync Fastify API and Aiven service connectors (PostgreSQL, Kafka, OpenSearch).",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:migrate": "tsx src/db/migrations.ts",
    "search:init": "tsx src/search/mappings.ts"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^3.10.0",
    "fastify": "^5.12.8",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
