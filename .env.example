# =============================================================================
# RetailSync - environment configuration template
# =============================================================================
# 1. Copy this file to `.env` in the repository root:   cp .env.example .env
# 2. Fill in the values from the Aiven Console (each service's "Overview" tab).
# 3. NEVER commit `.env` or certificate files. `.gitignore` already excludes
#    `.env`, `*.pem`, `*.cert`, and `*.key`.
#
# Certificates can be supplied in either of two ways (the *_PATH form wins
# when both are set):
#   - *_PATH  : path to the downloaded file. Relative paths resolve from the
#               repository root (e.g. ./certs/ca.pem).
#   - inline  : the PEM text itself. Use "\n" for line breaks, or a
#               double-quoted multi-line value.
#
# Variables are validated at startup (backend/src/config.ts). A missing or
# malformed value stops the process with a list of the offending variable
# NAMES (values are never printed).
# =============================================================================

# -----------------------------------------------------------------------------
# Application server (Fastify)
# -----------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Shared Aiven project CA certificate
# -----------------------------------------------------------------------------
# All services in one Aiven project are signed by the same project CA.
# Download it from any service's Overview page ("CA certificate" -> ca.pem).
# Required for PostgreSQL and Kafka (they use the private project CA).
AIVEN_CA_CERT_PATH=./certs/ca.pem
# AIVEN_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# -----------------------------------------------------------------------------
# Aiven for PostgreSQL  (source of truth + row-level stock locking)
# -----------------------------------------------------------------------------
# Service URI from the Overview page. `sslmode=...` may be left in place; the
# app strips libpq ssl* parameters and enforces full certificate verification
# against the CA above (rejectUnauthorized: true).
AIVEN_PG_URI=postgres://avnadmin:CHANGE_ME@your-pg-service-your-project.e.aivencloud.com:12345/defaultdb?sslmode=require
# Optional per-service CA override (defaults to AIVEN_CA_CERT*):
# AIVEN_PG_CA_CERT_PATH=./certs/pg-ca.pem
# Connection pool tuning
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Aiven for Apache Kafka  (orders.placed / inventory.updated event stream)
# -----------------------------------------------------------------------------
# Comma-separated host:port list. NOTE: Aiven exposes DIFFERENT ports for
# client-certificate auth and SASL auth - copy the one matching AIVEN_KAFKA_AUTH.
AIVEN_KAFKA_BROKERS=your-kafka-service-your-project.e.aivencloud.com:12346

# Authentication method: `ssl` (client certificate, Aiven default) or `sasl`.
AIVEN_KAFKA_AUTH=ssl

# --- AIVEN_KAFKA_AUTH=ssl : client certificate ("Access certificate"/"Access key")
AIVEN_KAFKA_ACCESS_CERT_PATH=./certs/service.cert
AIVEN_KAFKA_ACCESS_KEY_PATH=./certs/service.key
# AIVEN_KAFKA_ACCESS_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# AIVEN_KAFKA_ACCESS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- AIVEN_KAFKA_AUTH=sasl : enable SASL in the Aiven Console first
# (Service settings -> Advanced configuration -> kafka_authentication_methods.sasl)
# AIVEN_KAFKA_SASL_MECHANISM=scram-sha-256   # scram-sha-256 | scram-sha-512 | plain
# AIVEN_KAFKA_SASL_USERNAME=avnadmin
# AIVEN_KAFKA_SASL_PASSWORD=CHANGE_ME

# Optional per-service CA override (defaults to AIVEN_CA_CERT*):
# AIVEN_KAFKA_CA_CERT_PATH=./certs/kafka-ca.pem
KAFKA_CLIENT_ID=retailsync-backend

# -----------------------------------------------------------------------------
# Aiven for OpenSearch  (typo-tolerant product search)
# -----------------------------------------------------------------------------
# Service URI from the Overview page (must be https, includes credentials).
# Credentials are split out of the URL internally so they never appear in logs.
AIVEN_OPENSEARCH_URI=https://avnadmin:CHANGE_ME@your-opensearch-service-your-project.e.aivencloud.com:12347

# Razorpay (backend only; key secret must never reach the browser). Unset = storefront simulates payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Payment invoices emailed after each verified Razorpay payment (Resend, https://resend.com).
# Unset = invoices are skipped. The default sender only delivers to the Resend account's own email.
RESEND_API_KEY=
INVOICE_EMAIL_TO=kushalchalla981@gmail.com
INVOICE_EMAIL_FROM=

# Gnani voice agent (v1.06): Prisma STT + Timbre TTS, server side only (sent as X-API-Key-ID).
GNANI_API_KEY=

# Merchant store API (v1.04): Clerk session tokens are verified with the instance JWKS.
# CLERK_PUBLISHABLE_KEY (or VITE_CLERK_PUBLISHABLE_KEY) identifies the Clerk instance.
CLERK_PUBLISHABLE_KEY=
# Optional: comma-separated frontend origins allowed in the token azp claim.
CLERK_AUTHORIZED_PARTIES=
# Optional: Clerk user id of the platform owner (defaults to the owner account).
PLATFORM_OWNER_CLERK_ID=
